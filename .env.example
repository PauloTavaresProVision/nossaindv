# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bucket usado para armazenar os PDFs gerados
SUPABASE_STORAGE_BUCKET=pdfs-beneficiarios

# ----- SMTP (envio de email) -----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=naoresponder@nossaseguros.ao
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME=Nossa Seguros
SMTP_FROM_EMAIL=naoresponder@nossaseguros.ao

# Email interno que recebe cópia de cada submissão (deixar vazio para desactivar)
INTERNAL_NOTIFICATION_EMAIL=

# ----- App -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
